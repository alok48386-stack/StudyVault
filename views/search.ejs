<%- include('partials/header') %>

<div class="container search-results-container">
  <!-- Search Breadcrumb -->
  <div class="breadcrumb">
    <a href="/">Home</a>
    <span class="separator">/</span>
    <span>Search</span>
    <span class="separator">/</span>
    <span class="current">"<%= query %>"</span>
  </div>

  <div class="search-header-box">
    <h1 class="search-title">Search Results for <em>"<%= query %>"</em></h1>
    <p class="search-count">
      Found <strong><%= results.length %></strong> matching note<%= results.length === 1 ? '' : 's' %>
    </p>
  </div>

  <% if (results && results.length > 0) { %>
    <div class="notes-grid">
      <% results.forEach(note => { %>
        <%- include('partials/note-card', { note }) %>
      <% }); %>
    </div>
  <% } else { %>
    <div class="empty-state search-empty">
      <div class="empty-icon">&#128269;</div>
      <h2>No notes found matching "<%= query %>"</h2>
      <p>We couldn't find any study notes matching your keywords. Try checking for typos or browse our subject categories below:</p>
      
      <div class="empty-category-list">
        <% categories.forEach(cat => { %>
          <a href="/?category=<%= cat.slug %>" class="filter-chip">
            <%= cat.name %> (<%= cat.note_count %>)
          </a>
        <% }); %>
      </div>

      <div style="margin-top: 1.5rem;">
        <a href="/" class="btn btn-primary">Return to Homepage</a>
      </div>
    </div>
  <% } %>
</div>

<%- include('partials/footer') %>
