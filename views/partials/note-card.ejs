<article class="note-card" data-category="<%= note.category_slug %>">
  <a href="/note/<%= note.slug %>" class="note-card-media-link" aria-label="<%= note.title %>">
    <div class="note-thumbnail-wrapper">
      <% const previewSrc = note.preview_image ? (note.preview_image.startsWith('/') ? note.preview_image : '/' + note.preview_image) : '/storage/previews/default-preview.svg'; %>
      <img 
        src="<%= previewSrc %>" 
        alt="<%= note.title %> Preview" 
        class="note-thumbnail" 
        loading="lazy"
        onerror="this.onerror=null; this.src='/storage/previews/default-preview.svg';"
      >
      <span class="file-badge <%= (note.file_type || 'pdf').toLowerCase() %>">
        <%= (note.file_type || 'PDF').toUpperCase() %>
      </span>
    </div>
  </a>

  <div class="note-card-body">
    <div class="note-card-meta-top">
      <a href="/?category=<%= note.category_slug %>" class="category-pill">
        <%= note.category_name %>
      </a>
      <span class="note-file-size">
        <%= formatBytes(note.file_size) %>
      </span>
    </div>

    <h3 class="note-card-title">
      <a href="/note/<%= note.slug %>" title="<%= note.title %>">
        <%= note.title %>
      </a>
    </h3>

    <div class="note-card-footer">
      <span class="note-uploader" title="Uploaded by <%= note.uploader_name || 'Admin' %>">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
          <circle cx="12" cy="7" r="4"></circle>
        </svg>
        <%= note.uploader_name || 'Admin' %>
      </span>

      <span class="note-downloads" title="<%= note.download_count %> total downloads">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
          <polyline points="7 10 12 15 17 10"></polyline>
          <line x1="12" y1="15" x2="12" y2="3"></line>
        </svg>
        <%= note.download_count %>
      </span>
    </div>
  </div>
</article>
