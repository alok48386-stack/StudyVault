<%- include('layout-header') %>

<div class="admin-page-header">
  <div>
    <h1 class="admin-heading">Subject Categories</h1>
    <p class="admin-subheading">Organize and manage note categories across your platform</p>
  </div>
</div>

<div class="categories-layout-grid">
  <!-- Left Column: Add New Category -->
  <div class="admin-card">
    <div class="admin-card-header">
      <h2 class="admin-card-title">Add New Subject</h2>
    </div>

    <form action="/admin/categories/new" method="POST" class="admin-form">
      <div class="form-group">
        <label for="name" class="form-label required">Subject Name</label>
        <input 
          type="text" 
          name="name" 
          id="name" 
          class="form-control" 
          placeholder="e.g. Economics, Biology, Statistics" 
          required
        >
        <small class="form-hint">A clean URL slug is generated automatically (e.g. "computer-science").</small>
      </div>

      <button type="submit" class="btn btn-primary btn-block">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
        Create Subject
      </button>
    </form>
  </div>

  <!-- Right Column: Current Categories List -->
  <div class="admin-card">
    <div class="admin-card-header">
      <h2 class="admin-card-title">Existing Subjects (<%= categories.length %>)</h2>
    </div>

    <div class="table-responsive">
      <table class="admin-table">
        <thead>
          <tr>
            <th>Subject Name</th>
            <th>URL Slug</th>
            <th>Notes Count</th>
            <th class="text-right">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if (categories && categories.length > 0) { %>
            <% categories.forEach(cat => { %>
              <tr>
                <td>
                  <strong><%= cat.name %></strong>
                </td>
                <td>
                  <code class="slug-tag">/category/<%= cat.slug %></code>
                </td>
                <td>
                  <span class="badge badge-pill <%= cat.note_count > 0 ? 'badge-primary' : 'badge-empty' %>">
                    <%= cat.note_count %> note<%= cat.note_count === 1 ? '' : 's' %>
                  </span>
                </td>
                <td class="text-right table-actions">
                  <!-- Inline Rename Trigger Button -->
                  <button 
                    type="button" 
                    class="btn btn-sm btn-outline edit-cat-btn" 
                    data-id="<%= cat.id %>"
                    data-name="<%= cat.name %>"
                  >
                    Rename
                  </button>

                  <!-- Delete form -->
                  <form 
                    action="/admin/categories/<%= cat.id %>/delete" 
                    method="POST" 
                    class="inline-form"
                    onsubmit="return confirm('Are you sure you want to delete this category?');"
                  >
                    <button 
                      type="submit" 
                      class="btn btn-sm btn-danger" 
                      <%= cat.note_count > 0 ? 'title="Reassign or delete existing notes first"' : '' %>
                    >
                      Delete
                    </button>
                  </form>
                </td>
              </tr>
            <% }); %>
          <% } else { %>
            <tr>
              <td colspan="4" class="text-center py-4 text-muted">No categories created yet.</td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- Modal for Renaming Category -->
<div id="categoryEditModal" class="modal-backdrop hidden">
  <div class="modal-dialog">
    <div class="modal-header">
      <h3 class="modal-title">Rename Subject</h3>
      <button type="button" class="modal-close" onclick="closeEditCategoryModal()">&times;</button>
    </div>
    <form id="editCategoryForm" method="POST" class="admin-form">
      <div class="modal-body">
        <div class="form-group">
          <label for="edit_name" class="form-label required">Updated Subject Name</label>
          <input type="text" name="name" id="edit_name" class="form-control" required>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" onclick="closeEditCategoryModal()">Cancel</button>
        <button type="submit" class="btn btn-primary">Save Changes</button>
      </div>
    </form>
  </div>
</div>

<script>
  function openEditCategoryModal(id, name) {
    const modal = document.getElementById('categoryEditModal');
    const form = document.getElementById('editCategoryForm');
    const input = document.getElementById('edit_name');
    form.action = '/admin/categories/' + id + '/edit';
    input.value = name;
    modal.classList.remove('hidden');
    input.focus();
  }

  function closeEditCategoryModal() {
    document.getElementById('categoryEditModal').classList.add('hidden');
  }

  // Handle rename button clicks
  document.querySelectorAll('.edit-cat-btn').forEach(btn => {
    btn.addEventListener('click', function() {
      openEditCategoryModal(this.getAttribute('data-id'), this.getAttribute('data-name'));
    });
  });

  // Close modal when clicking outside
  window.addEventListener('click', function(e) {
    const modal = document.getElementById('categoryEditModal');
    if (e.target === modal) {
      closeEditCategoryModal();
    }
  });
</script>

<%- include('layout-footer') %>
