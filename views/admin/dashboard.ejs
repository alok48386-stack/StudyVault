<%- include('layout-header') %>

<div class="admin-page-header">
  <div>
    <h1 class="admin-heading">Dashboard Overview</h1>
    <p class="admin-subheading">Live statistics and recently published student notes</p>
  </div>
  <div class="admin-header-actions">
    <a href="/admin/notes/new" class="btn btn-primary">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
      Upload New Note
    </a>
  </div>
</div>

<!-- Stat Cards -->
<div class="stats-grid">
  <div class="stat-card">
    <div class="stat-icon bg-indigo">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
    </div>
    <div class="stat-content">
      <span class="stat-label">Total Notes</span>
      <span class="stat-value"><%= stats.totalNotes %></span>
    </div>
  </div>

  <div class="stat-card">
    <div class="stat-icon bg-emerald">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
    </div>
    <div class="stat-content">
      <span class="stat-label">Total Downloads</span>
      <span class="stat-value"><%= stats.totalDownloads %></span>
    </div>
  </div>

  <div class="stat-card">
    <div class="stat-icon bg-amber">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path><line x1="7" y1="7" x2="7.01" y2="7"></line></svg>
    </div>
    <div class="stat-content">
      <span class="stat-label">Subjects / Categories</span>
      <span class="stat-value"><%= stats.totalCategories %></span>
    </div>
  </div>
</div>

<!-- Latest 5 Notes Section -->
<div class="admin-card">
  <div class="admin-card-header">
    <h2 class="admin-card-title">Recently Added Notes</h2>
    <a href="/admin/notes" class="view-all-link">View All Notes Library &rarr;</a>
  </div>

  <div class="table-responsive">
    <table class="admin-table">
      <thead>
        <tr>
          <th>Preview</th>
          <th>Title & Subject</th>
          <th>Format</th>
          <th>Size</th>
          <th>Downloads</th>
          <th>Uploaded</th>
          <th class="text-right">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if (latestNotes && latestNotes.length > 0) { %>
          <% latestNotes.forEach(note => { %>
            <tr>
              <td class="col-thumb">
                <% const pSrc = note.preview_image ? (note.preview_image.startsWith('/') ? note.preview_image : '/' + note.preview_image) : '/storage/previews/default-preview.svg'; %>
                <img src="<%= pSrc %>" alt="" class="table-thumb" onerror="this.src='/storage/previews/default-preview.svg';">
              </td>
              <td>
                <div class="table-note-title">
                  <a href="/note/<%= note.slug %>" target="_blank" class="title-link"><%= note.title %></a>
                </div>
                <span class="badge badge-sub"><%= note.category_name %></span>
              </td>
              <td>
                <span class="badge badge-type <%= (note.file_type || 'pdf').toLowerCase() %>">
                  <%= (note.file_type || 'PDF').toUpperCase() %>
                </span>
              </td>
              <td><%= formatBytes(note.file_size) %></td>
              <td>
                <strong><%= note.download_count %></strong>
              </td>
              <td class="text-muted"><%= formatDate(note.created_at) %></td>
              <td class="text-right table-actions">
                <a href="/admin/notes/<%= note.id %>/edit" class="btn btn-sm btn-outline">Edit</a>
                <form action="/admin/notes/<%= note.id %>/delete" method="POST" class="inline-form" onsubmit="return confirm('Are you sure you want to permanently delete this note?');">
                  <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                </form>
              </td>
            </tr>
          <% }); %>
        <% } else { %>
          <tr>
            <td colspan="7" class="text-center py-4 text-muted">No notes uploaded yet. Click "+ Add Note" to create your first note!</td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<%- include('layout-footer') %>
